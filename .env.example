# Copy to .env (git-ignored) and fill in locally. Never commit real values.
# CI reads these from GitHub Actions secrets instead.

# AI features (byLLM + Gemini), plan P8
GEMINI_API_KEY=

# Payments (plan P5, ADR-0015): "simulator" (tests, demos) or "daraja" (from P5.2).
# No default: without it the server refuses to take payments.
AFRICINEMAS_PAYMENTS=

# Signs ticket QR codes (plan P6.1): a random secret, at least 32 characters, e.g.
# `openssl rand -hex 32`. Without it payments are refused. Changing it invalidates
# every issued QR code.
AFRICINEMAS_TICKET_KEY=

# Seals each cinema's own M-Pesa keys (plan P15.3, ADR-0082): a random secret, at least
# 32 characters, e.g. `openssl rand -hex 32`. Without it cinemas can't connect M-Pesa.
# Back it up: losing it means every cinema connects M-Pesa again.
AFRICINEMAS_MPESA_KEY=
# Seals verification files (owners' ID photos, business certificates) at rest (P15.0).
# A different secret from the M-Pesa one, at least 32 characters, e.g.
# `openssl rand -hex 32`. Without it owners can't upload verification documents.
# Back it up: losing it means the documents already uploaded can't be opened.
AFRICINEMAS_FILES_KEY=

# AfriCinemas' own paybill, where cinemas pay their monthly invoices (plan P15.4,
# ADR-0083). Until it's live, statements show the placeholder 000000 and tell cinemas
# not to pay yet.
AFRICINEMAS_BILLING_PAYBILL=

# The AfriCinemas platform console (plan P13.1, ADR-0055, ADR-0056): the emails of its
# super admins, comma separated. Each gets their platform account (its own password,
# apart from any cinema account) from the link scripts/platform_setup.sh prints; they
# then invite reviewers and support staff in the console. Empty: nobody reaches it.
AFRICINEMAS_PLATFORM_ADMINS=

# Ticket emails (plan P6.3, ADR-0022). Without an SMTP host nothing is sent: emails are
# written to .jac/outbox (or AFRICINEMAS_OUTBOX_DIR) as .eml files you can open.
AFRICINEMAS_SMTP_HOST=
AFRICINEMAS_SMTP_PORT=
AFRICINEMAS_SMTP_USERNAME=
AFRICINEMAS_SMTP_PASSWORD=
# Our sending address; each email shows the cinema's name with it.
AFRICINEMAS_MAIL_FROM=
# The site's public address, for the ticket link in emails (default http://localhost:8000).
AFRICINEMAS_PUBLIC_URL=
# The domain AfriCinemas' three sites live under (ADR-0057): the back office on it, the
# platform on admin.<domain>, each cinema's storefront on <slug>.<domain>. Default: the
# host of AFRICINEMAS_PUBLIC_URL. Set it to localhost:8000 when that's a tunnel, which
# serves only its own address (the tunnel then reaches every site under /c/<slug>).
AFRICINEMAS_SITE_DOMAIN=

# M-Pesa Daraja sandbox, plan P5
DARAJA_CONSUMER_KEY=
DARAJA_CONSUMER_SECRET=
DARAJA_SHORTCODE=
DARAJA_PASSKEY=
# Public HTTPS base URL that Daraja calls back (e.g. a Cloudflare Tunnel URL)
DARAJA_CALLBACK_BASE=
# Optional: the API host (defaults to the sandbox, https://sandbox.safaricom.co.ke) and
# CustomerPayBillOnline (Paybill, the default) or CustomerBuyGoodsOnline (Till).
DARAJA_BASE_URL=
DARAJA_TRANSACTION_TYPE=
# The phone that receives the sandbox check's KES 1 prompt (scripts/sandbox.sh, P5.7)
DARAJA_TEST_PHONE=

# Server
# JWT signing secret. Required in production with more than one server process/replica
# (otherwise Jac mints a random per-project secret). See deploy/production.env.
JAC_SERVE_AUTH_SECRET=

# Desktop app: URL of the shared server it talks to (defaults to http://localhost:8000)
AFRICINEMAS_SERVER_URL=

# Folder for uploaded media such as movie posters (defaults to ./storage; git-ignored).
# Production uses object storage ([scale.storage] in jac.toml) instead.
AFRICINEMAS_MEDIA_DIR=

# Local machine quirks (optional)
# CPUs without AVX2 need bun's baseline build (docs/jac-issues/JI-002)
JAC_BUN=
