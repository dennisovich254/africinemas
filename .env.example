# Copy to .env (git-ignored) and fill in locally. Never commit real values.
# CI reads these from GitHub Actions secrets instead.

# AI features (byLLM + Gemini), plan P8
GEMINI_API_KEY=

# Payments (plan P5, ADR-0015): "simulator" (tests, demos) or "daraja" (from P5.2).
# No default: without it the server refuses to take payments.
AFRICINEMAS_PAYMENTS=

# M-Pesa Daraja sandbox, plan P5
DARAJA_CONSUMER_KEY=
DARAJA_CONSUMER_SECRET=
DARAJA_SHORTCODE=
DARAJA_PASSKEY=
# Public HTTPS base URL that Daraja calls back (e.g. a Cloudflare Tunnel URL)
DARAJA_CALLBACK_BASE=
# Optional: the API host (defaults to the sandbox, https://sandbox.safaricom.co.ke) and
# CustomerPayBillOnline (Paybill, the default) or CustomerBuyGoodsOnline (Till).
DARAJA_BASE_URL=
DARAJA_TRANSACTION_TYPE=

# Server
# JWT signing secret. Required in production with more than one server process/replica
# (otherwise Jac mints a random per-project secret). See deploy/production.env.
JAC_SERVE_AUTH_SECRET=

# Desktop app: URL of the shared server it talks to (defaults to http://localhost:8000)
AFRICINEMAS_SERVER_URL=

# Folder for uploaded media such as movie posters (defaults to ./storage; git-ignored).
# Production uses object storage ([scale.storage] in jac.toml) instead.
AFRICINEMAS_MEDIA_DIR=

# Local machine quirks (optional)
# CPUs without AVX2 need bun's baseline build (docs/jac-issues/JI-002)
JAC_BUN=
