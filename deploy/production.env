# Non-secret production settings (plan P0.7). Load these into the server's environment
# together with the secrets from the deployment's secret store:
#   JAC_SERVE_AUTH_SECRET   JWT signing secret (required with more than one process/replica)
#   JAC_DB_URL              Postgres connection string
#   AFRICINEMAS_TICKET_KEY  ticket QR signing secret, 32+ characters (plan P6.1)
#   AFRICINEMAS_MPESA_KEY   seals each cinema's Daraja keys, 32+ characters (plan P15.3, ADR-0082);
#                           losing it means every cinema connects M-Pesa again, so back it up
#   AFRICINEMAS_SMTP_PASSWORD  the email provider's SMTP password (plan P6.3)
#   AFRICINEMAS_PLATFORM_ADMINS  the platform console's super admins' emails, comma separated (plan P13.1);
#                                each then runs scripts/platform_setup.sh for their join link (ADR-0056)
#
# ALL [serve] hardening lives here as JAC_SERVE_* env vars. The running server
# ignores profile overrides for [serve] settings in Jac 0.37.18 (docs/jac-issues/JI-014),
# so [environments.production.serve] in jac.toml would silently do nothing.
# Verified over HTTP by tests/integration/production_server_tests.jac.
JAC_PROFILE=production
JAC_SERVE_DOCS=false
JAC_SERVE_GRAPH=false
JAC_SERVE_AUTH_TOKEN_TTL_DAYS=1
JAC_SERVE_MAX_BODY_BYTES=5242880
# The three sites (plan 13.1b, ADR-0057, docs/runbooks/three-sites.md): the back office on
# the domain, the platform on admin., each cinema's storefront on its slug. The public
# address is on the domain, so emails and Claude link to each cinema's own address.
AFRICINEMAS_SITE_DOMAIN=africinemas.co.ke
AFRICINEMAS_PUBLIC_URL=https://africinemas.co.ke
